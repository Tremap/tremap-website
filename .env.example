# Contact form email delivery (https://resend.com)
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Tremap website <info@tremap.com>"
CONTACT_FROM=
# Where enquiries are delivered (defaults to info@tremap.com)
CONTACT_TO=info@tremap.com

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Loaded only after the
# visitor accepts the cookie notice. Leave empty for no analytics and no notice.
NEXT_PUBLIC_GA_ID=
